{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "nodeBuiltinImport": "off",
          "globalConsole": "off",
          "globalDate": "off",
          "globalFetch": "off",
          "globalTimers": "off",
          "cryptoRandomUUID": "off"
        }
      }
    ]
  },
  "include": ["src", "test", "scripts"]
}
