{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "cryptoRandomUUID": "off",
          "globalConsole": "off",
          "globalDate": "off",
          "globalFetch": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "nodeBuiltinImport": "off"
        }
      }
    ]
  },
  "include": ["src"]
}
