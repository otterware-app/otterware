{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The web registry describes React components (lazy pages, icons) but
    // renders nothing itself: the shell in apps/web/src/otterware does.
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src"]
}
