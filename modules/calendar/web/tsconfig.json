{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalTimers": "off",
          "globalRandom": "off"
        }
      }
    ],
    "erasableSyntaxOnly": false
  },
  "include": ["src"]
}
